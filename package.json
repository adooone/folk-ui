{
  "name": "@dendelion/folk-ui",
  "version": "0.25.0",
  "description": "Natural-material React component library — paper, ink, canvas, and watercolor",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "packageManager": "pnpm@10.12.1",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.mjs",
      "require": "./dist/tokens.cjs"
    },
    "./tailwind": {
      "types": "./tailwind.ts",
      "import": "./tailwind.ts",
      "require": "./tailwind.ts"
    },
    "./styles": {
      "types": "./src/styles/index.ts",
      "import": "./src/styles/index.ts",
      "require": "./src/styles/index.ts"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "tailwind.ts",
    "tailwind.config.js",
    "postcss.config.js",
    "src/tokens.ts",
    "src/components",
    "src/styles",
    "src/globals.scss",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "build:showcase": "vite build --config vite.app.config.ts",
    "dev": "vite",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "tokens": "node --experimental-strip-types scripts/tokens-scss.ts",
    "tokens:check": "node --experimental-strip-types scripts/tokens-scss.ts --check",
    "lint": "biome check ./src && stylelint \"src/**/*.scss\"",
    "lint:fix": "biome check ./src --write && stylelint \"src/**/*.scss\"",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "check-package": "publint",
    "ci": "pnpm run check-types && pnpm run tokens:check && pnpm run lint && pnpm run build && pnpm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adooone/folk-ui.git"
  },
  "bugs": {
    "url": "https://github.com/adooone/folk-ui/issues"
  },
  "homepage": "https://github.com/adooone/folk-ui#readme",
  "keywords": [
    "react",
    "components",
    "ui",
    "paper",
    "natural",
    "organic",
    "tailwindcss",
    "design-system"
  ],
  "author": "Dendelion",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "framer-motion": "^14.14.0",
    "roughjs": "^4.6.6",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "autoprefixer": "10.6.2",
    "jsdom": "^31.0.1",
    "postcss": "8.5.33",
    "postcss-scss": "^4.0.9",
    "publint": "^0.3.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass-embedded": "^1.108.2",
    "stylelint": "^18.0.0",
    "tailwindcss": "3.4.14",
    "typescript": "^5.0.0",
    "vite": "8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome"
    ]
  }
}
